{
  "name": "@restormel/dispatch",
  "version": "0.1.0",
  "description": "Restormel Dispatch — in-process model-execution envelope: a structured request/response Interaction Format for predictable AI interactions over @restormel/keys routing and cost. Not a wire protocol (see A2A for cross-agent interop).",
  "keywords": [
    "dispatch",
    "ai",
    "agent",
    "restormel",
    "interaction-format"
  ],
  "author": "Allotment Technology Ltd",
  "license": "MIT",
  "homepage": "https://github.com/Allotment-Technology-Ltd/restormel-keys/tree/main/packages/dispatch#readme",
  "bugs": {
    "url": "https://github.com/Allotment-Technology-Ltd/restormel-keys/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allotment-Technology-Ltd/restormel-keys.git",
    "directory": "packages/dispatch"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@restormel/keys": ">=0.1.0",
    "@restormel/mcp": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@restormel/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@restormel/mcp": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
