{
  "name": "@restormel/graph-reasoning-extensions",
  "version": "0.1.1",
  "description": "Compare, lineage, projection, and evaluation helpers over graph snapshots — depends on @restormel/contracts and @restormel/graph-core (not part of Contract v0 MVP).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allotment-Technology-Ltd/restormel-keys.git",
    "directory": "packages/graph-reasoning-extensions"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "PUBLISHING.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./compare": { "types": "./dist/compare.d.ts", "import": "./dist/compare.js" },
    "./diff": { "types": "./dist/diff.d.ts", "import": "./dist/diff.js" },
    "./evaluation": { "types": "./dist/evaluation.d.ts", "import": "./dist/evaluation.js" },
    "./lineage": { "types": "./dist/lineage.d.ts", "import": "./dist/lineage.js" },
    "./projection": { "types": "./dist/projection.d.ts", "import": "./dist/projection.js" },
    "./summary": { "types": "./dist/summary.d.ts", "import": "./dist/summary.js" }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@restormel/contracts": "workspace:*",
    "@restormel/graph-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
