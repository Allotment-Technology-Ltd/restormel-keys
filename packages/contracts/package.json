{
  "name": "@restormel/contracts",
  "version": "0.1.1",
  "description": "Restormel shared API and reasoning contracts (Zod schemas and types).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allotment-Technology-Ltd/restormel-keys.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
