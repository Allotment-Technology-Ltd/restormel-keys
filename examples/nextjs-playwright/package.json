{
  "name": "example-nextjs-playwright",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Next.js App Router demo + restormel-testing.yaml (no private credentials).",
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "next build",
    "start": "next start -p 3040",
    "validate": "testing validate --config restormel-testing.yaml",
    "run:web-critical": "testing run --suite web-critical --config restormel-testing.yaml"
  },
  "dependencies": {
    "next": "^16.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@restormel/testing-cli": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  }
}
