# Restormel Keys dashboard (SvelteKit adapter-node) — build and serve on Coolify/Docker.
# Build from repo root: docker build -f Dockerfile.dashboard -t restormel-dashboard .
#
# DEPLOY_TARGET=node is baked into the build stage so adapter-node output is produced.
# Auth and DB config are runtime env (Better Auth + Neon); no build-time secrets.
#
# Port: 8080 (set via ENV; override at runtime with PORT= if needed).
# Healthcheck: GET /keys/v1/catalog — the catalog contract endpoint (§4.6 of migration plan).
#
# NOTE: This image is for the dashboard container only. The ingest-worker container
# uses the same image with a different start command — see deploy/docker-compose.coolify.yml.

# --- Build stage ---
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Copy workspace manifests + lockfile first for layer-cache efficiency.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files so pnpm can resolve the workspace graph without
# copying the full source tree (avoids cache-busting on source changes alone).
# A .dockerignore in the repo root is the right way to exclude large dirs like
# node_modules and .git — ensure it exists (or prune manually below).
COPY . .

# Install all workspace dependencies (frozen to match lockfile).
RUN pnpm install --frozen-lockfile

# Build dashboard with adapter-node output.
ENV DEPLOY_TARGET=node
RUN pnpm --filter dashboard build

# --- Serve stage (production-only deps, non-root user) ---
FROM node:22-alpine AS serve

WORKDIR /app

# adapter-node outputs to apps/dashboard/build/ — copy the build artefact.
COPY --from=build /app/apps/dashboard/build ./build
# package.json is needed for npm to resolve production deps.
COPY --from=build /app/apps/dashboard/package.json ./package.json

# Install only production dependencies for the runtime image.
# --ignore-scripts: adapter-node has no postinstall scripts that matter here.
RUN npm install --omit=dev --ignore-scripts

# Create a non-root user to run the server.
RUN addgroup -S restormel && adduser -S restormel -G restormel && \
    chown -R restormel:restormel /app

USER restormel

# Runtime environment.
# ORIGIN is required by adapter-node for correct CSRF / form-action handling.
# Set it to the real public URL in Coolify env (e.g. https://restormel.dev).
# BODY_SIZE_LIMIT: ingest job POSTs carry source payloads — set generously.
ENV PORT=8080 \
    HOST=0.0.0.0 \
    NODE_ENV=production \
    BODY_SIZE_LIMIT=10485760

EXPOSE 8080

# Healthcheck: /keys/v1/catalog doubles as the container liveness probe and
# is the contract endpoint consumed by allotmentology.tech (§4.6, §4.3).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:${PORT}/keys/v1/catalog || exit 1

# adapter-node entry point.
CMD ["node", "build/index.js"]
