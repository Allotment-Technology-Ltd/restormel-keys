# Restormel Keys dashboard (SvelteKit) — build and serve on Cloud Run.
# Build from repo root: docker build -f Dockerfile.dashboard -t restormel-dashboard .

# --- Build stage ---
FROM node:20-alpine AS build
# Firebase client config is public (baked into client bundle). Pass at build time so Sign in with GitHub works.
ARG PUBLIC_FIREBASE_API_KEY
ARG PUBLIC_FIREBASE_AUTH_DOMAIN
ARG PUBLIC_FIREBASE_PROJECT_ID
ENV PUBLIC_FIREBASE_API_KEY=$PUBLIC_FIREBASE_API_KEY
ENV PUBLIC_FIREBASE_AUTH_DOMAIN=$PUBLIC_FIREBASE_AUTH_DOMAIN
ENV PUBLIC_FIREBASE_PROJECT_ID=$PUBLIC_FIREBASE_PROJECT_ID

RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter dashboard build

# --- Serve stage ---
FROM node:20-alpine
WORKDIR /app
# adapter-node outputs to apps/dashboard/build (index.js + client/ etc.)
COPY --from=build /app/apps/dashboard/build ./
COPY --from=build /app/apps/dashboard/package.json ./package.json
RUN npm install --omit=dev
ENV PORT=8080
# Cloud Run sets PORT at runtime
CMD ["node", "index.js"]
