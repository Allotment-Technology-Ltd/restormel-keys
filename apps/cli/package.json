{
  "name": "@restormel/cli",
  "version": "0.1.0",
  "private": true,
  "description": "restormel CLI — inspect a Restormel knowledge graph from the terminal.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "restormel": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@restormel/graphrag-core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.2.23",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
