{
  "name": "restormel-graph-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "pnpm -w --filter @restormel/graph-core run build && pnpm -w --filter @restormel/ui-graph-svelte run build",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@restormel/graph-core": "workspace:*",
    "@restormel/ui-graph-svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.2"
  }
}
