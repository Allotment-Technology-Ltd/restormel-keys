# Paddle (Phase 3 C3). Do not commit real values.
# Get client-side token from Paddle Dashboard → Developer tools → Authentication.
PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
# Base URL of the dashboard (e.g. https://restormel.dev when proxied at /keys/dashboard).
PUBLIC_KEYS_DASHBOARD_URL=https://your-dashboard-url.example.com
# Optional: sandbox price ID for testing checkout without dashboard.
# PUBLIC_PADDLE_SANDBOX_PRICE_ID=pri_...
