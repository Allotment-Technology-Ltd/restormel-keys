---
/**
 * Shared marketing layout: nav (logo, Keys, Docs, Pricing, GitHub, Dashboard) + footer.
 * Uses --rm-* tokens, Cormorant Garamond + JetBrains Mono.
 */
import "../styles/global.css";
import LogoLockup from "../components/LogoLockup.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="page">
      <header class="nav" role="banner">
        <nav class="nav-inner" aria-label="Main">
          <LogoLockup variant="nav" href="/" height="28" class="logo" />
          <ul class="nav-links">
            <li><a href="/keys">Keys</a></li>
            <li><a href="/keys/docs/">Docs</a></li>
            <li><a href="/keys/pricing">Pricing</a></li>
            <li><a href="https://github.com/Allotment-Technology-Ltd/restormel-keys" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="/keys/dashboard">Dashboard</a></li>
          </ul>
        </nav>
      </header>
      <main id="main-content" class="main" role="main">
        <slot />
      </main>
      <footer class="footer" role="contentinfo">
        <div class="footer-inner">
          <div class="footer-col">
            <span class="footer-col-title">Product</span>
            <ul class="footer-links" aria-label="Product">
              <li><a href="/keys">Keys</a></li>
              <li><a href="/keys/docs/">Docs</a></li>
              <li><a href="/keys/pricing">Pricing</a></li>
              <li><a href="/keys/dashboard">Dashboard</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Resources</span>
            <ul class="footer-links" aria-label="Resources">
              <li><a href="https://github.com/Allotment-Technology-Ltd/restormel-keys" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            </ul>
          </div>
          <div class="footer-col footer-brand">
            <LogoLockup variant="nav" href="/" height="24" class="footer-logo" />
            <p class="footer-tagline">Developer tools for AI</p>
          </div>
        </div>
        <p class="footer-copy">restormel.dev</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-size: 100%;
    -webkit-font-smoothing: antialiased;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--rm-surface-raised);
    color: var(--rm-sage);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--rm-radius);
    z-index: var(--z-modal);
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--rm-bg);
    color: var(--rm-text);
    font-family: var(--rm-font-ui);
    line-height: 1.5;
  }

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .nav {
    border-bottom: 1px solid var(--rm-border);
    background: var(--rm-surface);
    min-height: var(--rm-nav-height);
  }

  .nav-inner {
    max-width: var(--rm-container-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: var(--rm-nav-height);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .logo:hover {
    opacity: 0.9;
  }

  .logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--rm-radius);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .nav-links a {
    font-family: var(--rm-font-ui);
    font-size: var(--text-sm);
    color: var(--rm-muted);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--duration-fast) var(--ease);
  }

  .nav-links a:hover {
    color: var(--rm-sage);
  }

  .nav-links a:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--rm-radius);
  }

  .main {
    flex: 1;
    padding: var(--space-8) var(--space-6);
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--rm-border);
    background: var(--rm-surface);
    padding: var(--space-8) var(--space-6) var(--space-4);
  }

  .footer-inner {
    max-width: var(--rm-container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer-col-title {
    font-family: var(--rm-font-ui);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--rm-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-1);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--rm-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  .footer-links a:hover {
    color: var(--rm-sage);
  }

  .footer-links a:focus-visible,
  .footer-logo:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--rm-radius);
  }

  .footer-brand {
    text-align: right;
  }

  @media (max-width: 640px) {
    .footer-brand {
      text-align: left;
    }
  }

  .footer-logo {
    display: inline-flex;
    text-decoration: none;
    margin-bottom: var(--space-1);
    transition: opacity var(--duration-fast) var(--ease);
  }

  .footer-logo:hover {
    opacity: 0.9;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--rm-dim);
    margin: 0;
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--rm-dim);
    margin: var(--space-4) 0 0;
    text-align: center;
  }
</style>
