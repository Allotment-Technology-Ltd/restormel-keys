---
/**
 * Restormel marketing homepage — restormel.dev
 * Developer tools for AI. Keys = BYOK and provider routing. Launch-ready.
 */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import LogoLockup from "../components/LogoLockup.astro";
---

<MarketingLayout>
  <Fragment slot="head">
    <title>Restormel — Developer tools for AI</title>
    <meta name="description" content="Restormel — developer tools for AI applications. Restormel makes reasoning visible. Start with Keys: BYOK and provider routing for your stack." />
    <meta property="og:title" content="Restormel — Developer tools for AI" />
    <meta property="og:description" content="Restormel makes reasoning visible. Developer tools for AI applications. Keys: drop-in BYOK and provider routing." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://restormel.dev/" />
    <meta property="og:image" content="https://restormel.dev/restormel-social-avatar.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Restormel — Developer tools for AI" />
    <meta name="twitter:description" content="Restormel makes reasoning visible. Keys: drop-in BYOK and provider routing for AI apps." />
  </Fragment>

  <article class="home-page">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <h1 id="hero-heading" class="hero-brand">
          <LogoLockup variant="dark" href="/" class="hero-lockup" />
        </h1>
        <p class="hero-tagline">Restormel makes reasoning visible.</p>
        <p class="hero-desc">We build developer tools for AI-powered applications: the layers that give you multi-provider routing, production-grade key management, and cost control inside your own stack — not as someone else’s platform.</p>
      </div>
    </section>

    <section class="products" aria-labelledby="products-heading">
      <div class="container">
        <h2 id="products-heading" class="visually-hidden">Products</h2>
        <div class="product-card product-card-keys">
          <div class="product-card-inner">
            <h3 class="product-name">Keys</h3>
            <p class="product-one-liner">The drop-in BYOK and provider-routing layer for AI apps.</p>
            <p class="product-desc">Add key management and multi-provider routing to your app in an afternoon. One interface for OpenAI, Anthropic, Google; embeddable UI so your users can bring their own keys. Library-first — Next.js, React, SvelteKit, Web Components. No Docker, no proxy, no gateway. MIT core; optional cloud dashboard and billing when you need them.</p>
            <div class="product-ctas">
              <a href="/keys" class="btn btn-primary">See Keys</a>
              <a href="/keys/docs/" class="btn btn-secondary">Read the docs</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="trust" aria-labelledby="trust-heading">
      <div class="container container-narrow">
        <h2 id="trust-heading" class="visually-hidden">Why Restormel</h2>
        <p class="trust-line">For builders who ship. TypeScript-native. MIT. No lock-in.</p>
      </div>
    </section>
  </article>
</MarketingLayout>

<style>
  .home-page {
    --home-max: var(--rm-container-max);
  }

  .container {
    max-width: var(--home-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .container-narrow {
    max-width: var(--rm-container-narrow);
  }

  .hero {
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
  }

  .hero-brand {
    margin: 0 0 var(--space-4);
    line-height: 1;
  }

  .hero-brand :global(.logo-lockup-wrap) {
    display: inline-block;
  }

  .hero-brand :global(.logo-lockup) {
    max-width: min(320px, 85vw);
    height: auto;
  }

  .hero-tagline {
    font-family: var(--rm-font-ui);
    font-size: var(--text-xl);
    font-weight: var(--font-normal);
    color: var(--rm-sage);
    margin: 0 0 var(--space-5);
  }

  .hero-desc {
    font-size: var(--text-base);
    color: var(--rm-muted);
    line-height: var(--leading-relaxed);
    max-width: var(--rm-reading-width);
    margin: 0 auto;
  }

  .products {
    padding: 0 0 var(--space-16);
  }

  .product-card {
    background: var(--rm-surface-raised);
    border: 1px solid var(--rm-border);
    border-radius: var(--rm-card-radius);
    box-shadow: var(--rm-card-shadow);
    overflow: hidden;
  }

  .product-card-inner {
    padding: var(--space-8);
  }

  @media (max-width: 640px) {
    .product-card-inner {
      padding: var(--space-6);
    }
  }

  .product-name {
    font-family: var(--rm-font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--rm-text);
    margin: 0 0 var(--space-2);
  }

  .product-one-liner {
    font-family: var(--rm-font-ui);
    font-size: var(--text-base);
    color: var(--rm-sage);
    margin: 0 0 var(--space-3);
  }

  .product-desc {
    font-size: var(--text-sm);
    color: var(--rm-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-6);
    max-width: 42rem;
  }

  .product-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .btn {
    display: inline-block;
    font-family: var(--rm-font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--rm-radius);
    text-decoration: none;
  }

  .btn-primary {
    background: var(--rm-sage);
    color: var(--ink);
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .btn-secondary {
    background: transparent;
    color: var(--rm-text);
    border: 1px solid var(--rm-border);
  }

  .btn-secondary:hover {
    border-color: var(--rm-sage);
    color: var(--rm-sage);
  }

  .trust {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--rm-border);
    text-align: center;
  }

  .trust-line {
    font-size: var(--text-sm);
    color: var(--rm-dim);
    margin: 0;
    max-width: var(--rm-reading-width);
    margin-left: auto;
    margin-right: auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
