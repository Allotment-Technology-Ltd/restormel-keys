---
/**
 * Restormel icon-only mark (concentric routing symbol). Use where space is tight or icon-only is needed.
 */
interface Props {
  size?: number | string;
  href?: string;
  class?: string;
}

const { size = 32, href = "/", class: className = "" } = Astro.props;

const s = typeof size === "number" ? `${size}px` : size;

const img = (
  <img
    src="/restormel-mark-icon.svg"
    alt=""
    width={typeof size === "number" ? size : undefined}
    height={typeof size === "number" ? size : undefined}
    class={`logo-mark ${className}`.trim()}
    style={{ width: s, height: s }}
    aria-hidden="true"
  />
);
---

{href ? (
  <a href={href} class="logo-mark-wrap" aria-label="Restormel home">
    {img}
  </a>
) : (
  <span class="logo-mark-wrap">{img}</span>
)}

<style>
  .logo-mark-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .logo-mark {
    display: block;
    object-fit: contain;
  }
</style>
