# Copy to .env. Set in Vercel or locally. Do not commit.

# Neon (database). Do not commit real values.
# Get DATABASE_URL from Neon Console (or Neon MCP get_connection_string).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth (GitHub OAuth). Set in Vercel → Settings → Environment Variables.
# NEON_AUTH_BASE_URL=https://restormel.dev  (no trailing slash; dashboard is at /keys/dashboard)

# ---- Auth provider switch (P4) ----
# Selects the dashboard auth backend. DEFAULTS to `neon` (managed Neon Auth, the
# current production behaviour). Flip to `self` ONLY at an explicit, owner-gated
# cutover to use the in-process self-hosted Better Auth. Leaving this unset == neon.
# AUTH_PROVIDER=neon            # neon | self  (default neon)
#
# Required ONLY when AUTH_PROVIDER=self (the self-hosted Better Auth path). On the
# default `neon` path these are ignored and the values below can stay unset.
# BETTER_AUTH_SECRET=           # 32+ byte random secret (openssl rand -base64 32)
# GITHUB_CLIENT_ID=             # GitHub OAuth app client id (self-host auth)
# GITHUB_CLIENT_SECRET=         # GitHub OAuth app client secret (self-host auth)
# BETTER_AUTH_URL=              # optional origin override for non-prod (prod uses https://restormel.dev)
#
# Transactional email for the self-host path (SMTP, implicit TLS on 465).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Restormel Keys <notify@restormel.dev>   # transactional From
# EMAIL_REPLY_TO=contact@restormel.dev               # transactional Reply-To (security/ops mail uses admin@)

# ---- Verifying proxy — remote path (Phase C scaffold, REC-PLAN-011) ----
# The remote, multi-tenant connect-to-Claude path is HARD-gated and NOT live. Phase
# C only builds + tests the OAuth resource-server auth machinery (Ory Hydra) behind
# the flag below. There is NO public /mcp route and NO ingress in this phase, and
# leaving everything below unset changes nothing — the remote path stays OFF.
#
# RESTORMEL_VERIFYING_PROXY_REMOTE=false   # 1|true|on|enabled to arm; default OFF
#
# Ory Hydra resource-server validation (app-side only — does NOT stand up Hydra).
# Required only when the remote path is later enabled at an explicit go-live step.
# ORY_HYDRA_ISSUER=             # expected token issuer (iss), e.g. https://hydra.restormel.dev
# ORY_HYDRA_AUDIENCE=           # this proxy's resource id — the aud every token MUST carry
# ORY_HYDRA_JWKS_URI=           # JWKS endpoint for stateless JWT verification (preferred)
# ORY_HYDRA_ADMIN_URL=          # Hydra admin URL for token introspection (fallback)
# ORY_HYDRA_REQUIRED_SCOPE=     # optional scope every token MUST include (e.g. connect.proxy)

# Paddle (billing). In Vercel set from dashboard secrets; locally optional for checkout.
# PADDLE_API_KEY=       # Paddle Dashboard → Authentication
# PADDLE_SECRET=        # Webhook signing secret (Paddle Dashboard → Webhooks)
# PADDLE_ENVIRONMENT=sandbox
# PUBLIC_PADDLE_CLIENT_TOKEN=   # Client-side token for Paddle.js (pricing); from Paddle Dashboard → Authentication

# Optional: public URL for pricing/checkout links (Vercel sets automatically for server; client uses origin).
# PUBLIC_KEYS_DASHBOARD_URL=https://restormel.dev/keys/dashboard

# PostHog (A/B testing). Create a project at posthog.com; paste the project API key.
PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional feedback issue relay (GitHub Issues API)
# PAT should include issues:write for the target repository.
FEEDBACK_GITHUB_TOKEN=REPLACE_WITH_GITHUB_PAT
# owner/repo format (defaults to restormel-keys/restormel-keys in code)
FEEDBACK_GITHUB_REPO=Allotment-Technology-Ltd/restormel-keys
