# Copy to .env. Set in Vercel or locally. Do not commit.

# Neon (database). Do not commit real values.
# Get DATABASE_URL from Neon Console (or Neon MCP get_connection_string).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth (GitHub OAuth). Set in Vercel → Settings → Environment Variables.
# NEON_AUTH_BASE_URL=https://restormel.dev  (no trailing slash; dashboard is at /keys/dashboard)

# Paddle (billing). In Vercel set from dashboard secrets; locally optional for checkout.
# PADDLE_API_KEY=       # Paddle Dashboard → Authentication
# PADDLE_SECRET=        # Webhook signing secret (Paddle Dashboard → Webhooks)
# PADDLE_ENVIRONMENT=sandbox
# PUBLIC_PADDLE_CLIENT_TOKEN=   # Client-side token for Paddle.js (pricing); from Paddle Dashboard → Authentication

# Optional: public URL for pricing/checkout links (Vercel sets automatically for server; client uses origin).
# PUBLIC_KEYS_DASHBOARD_URL=https://restormel.dev/keys/dashboard

# PostHog (A/B testing). Create a project at posthog.com; paste the project API key.
PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
PUBLIC_POSTHOG_HOST=https://app.posthog.com
