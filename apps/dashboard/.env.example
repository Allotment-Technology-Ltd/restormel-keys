# Firebase (client). Do not commit real values.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin: use GOOGLE_APPLICATION_CREDENTIALS path in Cloud Run, or set below for local dev.
# Paddle (Phase 3 C3). In Cloud Run injected from Secret Manager via Pulumi.
# PADDLE_API_KEY=       # Server-side API key (Paddle Dashboard → Authentication).
# PADDLE_SECRET=        # Webhook signing secret (Paddle Dashboard → Webhooks). Also PADDLE_WEBHOOK_SECRET.
# PADDLE_ENVIRONMENT=sandbox

# Neon (dashboard storage). When USE_NEON_DB=true and DATABASE_URL is set, dashboard uses Neon instead of Firestore.
# Get DATABASE_URL from Neon MCP (get_connection_string) or Neon Console. Do not commit.
# USE_NEON_DB=false
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
