{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite dev",
    "precheck": "pnpm -w --filter @restormel/keys-tokens run build && pnpm -w --filter @restormel/keys run build && pnpm -w --filter @restormel/keys-svelte run build && pnpm -w --filter @restormel/mcp run build && pnpm -w --filter @restormel/support run build",
    "build": "vite build && node ../../scripts/vercel-copy-build-output.mjs",
    "prebuild": "pnpm -w --filter @restormel/keys-tokens run build && pnpm -w --filter @restormel/keys run build && pnpm -w --filter @restormel/keys-svelte run build && pnpm -w --filter @restormel/mcp run build && pnpm -w --filter @restormel/support run build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "seed:catalog": "node scripts/ingest-model-catalog.mjs",
    "seed:catalog:from-keys": "node scripts/seed-model-catalog-from-keys.mjs"
  },
  "devDependencies": {
    "@testing-library/svelte": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^25.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.2.0-beta.1",
    "@neondatabase/serverless": "^1.0.2",
    "@restormel/keys": "workspace:*",
    "@restormel/mcp": "workspace:*",
    "@restormel/keys-react": "workspace:*",
    "@restormel/keys-svelte": "workspace:*",
    "@restormel/keys-tokens": "workspace:*",
    "@restormel/support": "workspace:*",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.3.1",
    "markdown-it": "^14.1.1",
    "pg": "^8.20.0",
    "posthog-js": "^1.364.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.2"
  },
  "type": "module"
}
