# ── Restormel MCP knowledge server ─────────────────────────────────────────
# Copy to .env (or export in your MCP client config) and fill in.

# Graph store backend. surrealdb (default) | neo4j
RESTORMEL_GRAPH_STORE_TYPE=surrealdb

# Connection URL for the graph store.
#   SurrealDB: the HTTP /sql endpoint, e.g. https://db.example.com/sql
#              Namespace + database come from the last two path segments
#              (…/sql/<namespace>/<database>) or query string (?ns=..&db=..).
#   Neo4j:     a bolt:// or neo4j:// URI, e.g. neo4j://localhost:7687
RESTORMEL_GRAPH_STORE_URL=https://your-surreal-host/sql

# Credentials as a JSON object. Accepts { "username", "password" } or { "user", "password" }.
RESTORMEL_GRAPH_STORE_CREDS={"username":"root","password":"root"}

# Workspace this server serves. Fallback when a tool call omits workspace_id.
RESTORMEL_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Default verification policy: comma-separated categories.
#   supported            (default — Restormel's trust promise)
#   supported,weak       (widen to include unverified evidence)
#   supported,weak,unsupported  (everything, including flagged)
RESTORMEL_DEFAULT_VERIFICATION=supported

# Default token budget applied to context blocks when a tool omits max_tokens.
RESTORMEL_MAX_TOKENS=2000

# Logging verbosity (stderr only): debug | info | warn | error
RESTORMEL_LOG_LEVEL=info

# Transport: stdio (default, for Claude Desktop / Cursor) | http
RESTORMEL_TRANSPORT=stdio

# Port used only when RESTORMEL_TRANSPORT=http
RESTORMEL_PORT=3000
