# Zuplo gateway — copy to .env and fill in. Do not commit .env.
# Value sources: docs/runbooks/zuplo-setup.md § Where to get each value

# Required for setup-from-cli.sh and deploy
ZUPLO_API_KEY=
# e.g. https://restormel.dev/keys/dashboard (no trailing slash)
KEYS_BACKEND_URL=
KEYS_BACKEND_API_KEY=

# Site root for /keys/v1, /graph/v1, /connect/v1 forwards (no trailing slash).
# Defaults to https://restormel.dev if unset.
# KEYS_SITE_ORIGIN=https://restormel.dev
# Comma-separated origins for the restormel-cors gateway CORS policy (supports wildcards).
# Defaults to https://restormel.dev,https://*.restormel.dev if unset.
# ALLOWED_CORS_ORIGINS=https://restormel.dev,https://*.restormel.dev

# Optional: override defaults for setup/deploy
# ZUPLO_ACCOUNT_NAME=
# ZUPLO_PROJECT_NAME=restormel-keys-gateway
# ZUPLO_BRANCH=main

# Required for create-consumer-and-test.sh (get GATEWAY_URL from Portal → Environments → env → Gateway)
# ZUPLO_BUCKET_NAME=
# GATEWAY_URL=

# After creating a consumer: put the zpka_... key here for test-gateway.sh and launch-checklist.sh
# ZUPLO_CONSUMER_KEY=
