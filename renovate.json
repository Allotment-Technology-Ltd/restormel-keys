{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Self-hosted Renovate config for restormel-keys (Forgejo-primary).",

  "extends": [
    "config:recommended",
    "group:monorepos",
    ":dependencyDashboard",
    ":semanticCommits"
  ],

  "platform": "gitea",
  "gitAuthor": "Renovate Bot <renovate[bot]@restormel.dev>",

  "schedule": ["after 3am and before 6am on Monday"],
  "timezone": "Europe/London",

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "labels": ["dependencies", "renovate"],

  "packageRules": [
    {
      "description": "Auto-merge patch + minor devDependencies on green CI",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["dependencies", "renovate", "auto-merge"]
    },
    {
      "description": "NEVER auto-merge major version bumps — open PR for human review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "renovate", "major-bump"]
    },
    {
      "description": "NEVER auto-merge runtime-critical packages regardless of update type",
      "matchPackageNames": [
        "@auth/pg-adapter",
        "better-auth",
        "drizzle-orm",
        "postgres",
        "@neondatabase/serverless",
        "vite",
        "svelte",
        "@sveltejs/kit",
        "@sveltejs/adapter-node",
        "node"
      ],
      "automerge": false,
      "labels": ["dependencies", "renovate", "runtime-critical"]
    },
    {
      "description": "Security/vulnerability updates — raise immediately with high priority, never auto-merge",
      "matchCategories": ["security"],
      "automerge": false,
      "prPriority": 10,
      "prCreation": "immediate",
      "labels": ["dependencies", "renovate", "security", "priority-high"]
    },
    {
      "description": "Group all Svelte/SvelteKit packages together",
      "matchPackageNames": ["@sveltejs/{/,}**", "svelte{/,}**"],
      "groupName": "Svelte ecosystem"
    },
    {
      "description": "Group all TypeScript/tsconfig packages together",
      "matchPackageNames": ["typescript{/,}**", "@typescript-eslint/{/,}**", "tsup{/,}**", "tsx{/,}**"],
      "groupName": "TypeScript toolchain"
    },
    {
      "description": "Group all Vitest/testing packages together",
      "matchPackageNames": ["vitest{/,}**", "@vitest/{/,}**", "playwright{/,}**", "@playwright/{/,}**"],
      "groupName": "Testing toolchain"
    },
    {
      "description": "Pin GitHub Actions to exact digest (SHA) for supply-chain safety",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": false,
      "labels": ["dependencies", "renovate", "github-actions"]
    },
    {
      "description": "Internal @restormel/* workspace packages are versioned in-repo (pnpm workspace: / peer-dep ranges). Disable npm-datasource lookups so the published, deprecated @restormel/keys package does not appear on the Dependency Dashboard — they are never upgraded via Renovate.",
      "matchPackageNames": ["@restormel/**"],
      "enabled": false
    }
  ],

  "vulnerabilityAlerts": {
    "description": "OSV/GitHub Advisory vulnerability alerts — immediate PR, high priority (prPriority is applied via the security packageRule, which is the only place Renovate accepts it)",
    "enabled": true,
    "labels": ["dependencies", "renovate", "security", "priority-high"]
  },

  "osvVulnerabilityAlerts": true,

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard",
  "dependencyDashboardLabels": ["dependencies", "renovate"]
}
