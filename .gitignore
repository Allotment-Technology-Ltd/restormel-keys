apps/dashboard/package-lock.json

# Repomix (local repo packs for LLMs; do not commit)
*-snapshot.xml
repomix-output.xml
repomix-output.md
repomix-output.txt

# Build and tooling
dist/
build/
infra/bin/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
.dev.vars
.restormel/

# OS
.DS_Store
Thumbs.db

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# Logs and temp
*.log
.tmp/
tmp/
temp/

# Next.js / framework build (do not commit)
.next/

# SvelteKit / Astro build and generated (do not commit)
.svelte-kit/
.astro/

# Optional: uncomment when packages exist
# packages/*/dist/
.vercel

# Local Restormel Testing run / runs-api artefacts (do not commit)
.restormel-testing/

# Local-only internal notes (not committed)
internal/**
!internal/README.md

# Cursor plan artifacts (local-only)
.cursor/plans/**
